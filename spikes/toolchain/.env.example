# Copy to .env (gitignored). Only the names of settings live in the repository.
OPENROUTER_API_KEY=
# Optional: the model id the hello uses; any chat model OpenRouter serves.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Compose PostgreSQL password for measure.sh (synthetic; the script supplies one if empty).
POSTGRES_PASSWORD=
# Required for the dependency vulnerability check (the NVD refuses keyless downloads); export it
# into the shell before ./mvnw verify: set -a; . ./.env; set +a
NVD_API_KEY=
