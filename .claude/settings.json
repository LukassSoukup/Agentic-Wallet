{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": [
    "**/.claude/CLAUDE.md",
    "**/.claude/rules/**"
  ],
  "skillOverrides": {
    "health": "off"
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/data_check.py)",
      "Read(//**/leash-analysis/**)"
    ],
    "deny": [
      "Agent(system-health-check)",
      "Read(~/.claude/CLAUDE.md)",
      "Read(~/.claude/rules/**)",
      "Read(~/.claude/docs/**)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/.claude/docs/**)",
      "Read(//**/leash/**)",
      "Edit(//**/leash/**)",
      "Read(//**/leash-analysis/lukas/**)",
      "Edit(//**/leash-analysis/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_raw_data.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
